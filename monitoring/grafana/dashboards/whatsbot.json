{
  "title": "WhatsBot",
  "uid": "whatsbot-main",
  "schemaVersion": 39,
  "refresh": "15s",
  "tags": ["WhatsBot"],
  "panels": [
    {
      "id": 1,
      "title": "WhatsBot Up",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "expr": "up{job=\"whatsbot\"}",
        "legendFormat": "up"
      }]
    },
    {
      "id": 2,
      "title": "HTTP RPS",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{
        "expr": "sum(rate(air_whatsbot_http_requests_total[5m]))",
        "legendFormat": "RPS"
      }]
    },
    {
      "id": 3,
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{
        "expr": "sum(air_whatsbot_active_sessions)",
        "legendFormat": "sessions"
      }]
    },
    {
      "id": 4,
      "title": "Active Dialogs",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{
        "expr": "sum(air_whatsbot_active_dialogs)",
        "legendFormat": "dialogs"
      }]
    },
    {
      "id": 5,
      "title": "HTTP Requests by Route",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{
        "expr": "sum(rate(air_whatsbot_http_requests_total[5m])) by (route, status)",
        "legendFormat": "{{route}} {{status}}"
      }]
    },
    {
      "id": 6,
      "title": "HTTP Latency p95, s",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(air_whatsbot_http_request_duration_seconds_bucket[5m])) by (le, route))",
        "legendFormat": "{{route}}"
      }]
    },
    {
      "id": 7,
      "title": "Messages Received",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{
        "expr": "sum(rate(air_whatsbot_messages_received_total[5m])) by (bot_id, message_type)",
        "legendFormat": "bot {{bot_id}} {{message_type}}"
      }]
    },
    {
      "id": 8,
      "title": "Messages Processed",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [{
        "expr": "sum(rate(air_whatsbot_messages_processed_total[5m])) by (bot_id, status)",
        "legendFormat": "bot {{bot_id}} {{status}}"
      }]
    },
    {
      "id": 9,
      "title": "Decrypt Errors",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [{
        "expr": "sum(rate(air_whatsbot_decrypt_errors_total[5m])) by (bot_id, category)",
        "legendFormat": "bot {{bot_id}} {{category}}"
      }]
    },
    {
      "id": 10,
      "title": "Reconnects",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [{
        "expr": "sum(rate(air_whatsbot_reconnects_total[5m])) by (bot_id, result)",
        "legendFormat": "bot {{bot_id}} {{result}}"
      }]
    }
  ]
}
