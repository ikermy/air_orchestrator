                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_payment_monitor_errors_total[5m])) by (operation)",
                    "seriesNameFormat": "error: {{operation}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-16": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Monitor Cycle Duration, s"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(air_pay_payment_monitor_cycle_duration_seconds_bucket[5m])) by (le))",
                    "seriesNameFormat": "p95"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-17": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Database Operations"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_database_operations_total[5m])) by (operation, status)",
                    "seriesNameFormat": "{{operation}} / {{status}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-18": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Database Duration, s"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(air_pay_database_operation_duration_seconds_bucket[5m])) by (le, operation))",
                    "seriesNameFormat": "{{operation}} p95"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-19": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Payment Status Changes"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_payment_status_changes_total[5m])) by (from, to, currency)",
                    "seriesNameFormat": "{{from}} → {{to}} / {{currency}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-20": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Payment Reuse"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_payment_reuse_total[5m])) by (result)",
                    "seriesNameFormat": "{{result}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(air_pay_active_payments) by (status)",
                    "seriesNameFormat": "active: {{status}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": ""
          },
          "items": [
