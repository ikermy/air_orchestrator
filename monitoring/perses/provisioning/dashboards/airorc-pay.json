{
  "kind": "Dashboard",
  "metadata": {
    "name": "airorc-pay",
    "project": "air"
  },
  "spec": {
    "display": {
      "name": "AiR Pay"
    },
    "duration": "6h",
    "refreshInterval": "15s",
    "panels": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP RPS"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_http_requests_total[5m]))",
                    "seriesNameFormat": "RPS"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP p95, s"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(air_pay_http_request_duration_seconds_bucket[5m])) by (le))",
                    "seriesNameFormat": "p95"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active SSE Connections"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "air_pay_sse_connections",
                    "seriesNameFormat": "connections"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active Payments"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(air_pay_active_payments)",
                    "seriesNameFormat": "payments"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP Requests by Route"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_http_requests_total[5m])) by (method, route, status)",
                    "seriesNameFormat": "{{method}} {{route}} {{status}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP Latency p50 / p95 / p99, s"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.50, sum(rate(air_pay_http_request_duration_seconds_bucket[5m])) by (le))",
                    "seriesNameFormat": "p50"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(air_pay_http_request_duration_seconds_bucket[5m])) by (le))",
                    "seriesNameFormat": "p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.99, sum(rate(air_pay_http_request_duration_seconds_bucket[5m])) by (le))",
                    "seriesNameFormat": "p99"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Payment Operations"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_payment_operations_total[5m])) by (operation, status)",
                    "seriesNameFormat": "{{operation}} / {{status}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Payment Status"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_payment_status_total[5m])) by (status, currency)",
                    "seriesNameFormat": "{{status}} / {{currency}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Payment Amount by Currency"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_payment_amount_total[5m])) by (currency)",
                    "seriesNameFormat": "{{currency}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Payment Duration by Operation, s"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(air_pay_payment_processing_duration_seconds_bucket[5m])) by (le, operation))",
                    "seriesNameFormat": "{{operation}} p95"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Bybit API Requests"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_bybit_api_requests_total[5m])) by (operation, status)",
                    "seriesNameFormat": "{{operation}} / {{status}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-12": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Bybit API Duration, s"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(air_pay_bybit_api_request_duration_seconds_bucket[5m])) by (le, operation))",
                    "seriesNameFormat": "{{operation}} p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(air_pay_bybit_rate_limit_total[5m])",
                    "seriesNameFormat": "rate limits"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-13": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SSE Connections and Messages"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "air_pay_sse_connections",
                    "seriesNameFormat": "connections"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_sse_messages_total[5m])) by (event, status)",
                    "seriesNameFormat": "{{event}} / {{status}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_pay_sse_messages_dropped_total[5m])) by (reason)",
                    "seriesNameFormat": "dropped: {{reason}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-14": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SSE Connection Duration, s"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(air_pay_sse_connection_duration_seconds_bucket[5m])) by (le, status))",
                    "seriesNameFormat": "{{status}} p95"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-15": {
        "kind": "Panel",
        "spec": {
