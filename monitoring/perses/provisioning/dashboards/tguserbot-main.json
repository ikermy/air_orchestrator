{
  "kind": "Dashboard",
  "metadata": {
    "name": "tguserbot-main",
    "project": "air"
  },
  "spec": {
    "display": {
      "name": "TgUserBot"
    },
    "duration": "1h",
    "refreshInterval": "15s",
    "panels": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "TgUserBot Up"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "up{job=\"tguserbot\"}",
                    "seriesNameFormat": "up"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP RPS"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_http_requests_total[5m]))",
                    "seriesNameFormat": "RPS"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active Sessions"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(air_tguserbot_active_sessions)",
                    "seriesNameFormat": "sessions"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Auth Sessions"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(air_tguserbot_auth_sessions)",
                    "seriesNameFormat": "auth"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP Requests by Route"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_http_requests_total[5m])) by (route, status)",
                    "seriesNameFormat": "{{route}} {{status}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP Latency p95, s"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(air_tguserbot_http_request_duration_seconds_bucket[5m])) by (le, route))",
                    "seriesNameFormat": "{{route}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Messages Received"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_messages_received_total[5m])) by (bot_id, message_type)",
                    "seriesNameFormat": "bot {{bot_id}} {{message_type}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Messages Processed"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_messages_processed_total[5m])) by (bot_id, status)",
                    "seriesNameFormat": "bot {{bot_id}} {{status}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Messages Ignored"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_messages_ignored_total[5m])) by (bot_id, reason)",
                    "seriesNameFormat": "bot {{bot_id}} {{reason}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Bot Lifecycle Events"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_bot_lifecycle_total[5m])) by (bot_id, action, status)",
                    "seriesNameFormat": "bot {{bot_id}} {{action}} {{status}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CRM Requests"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_crm_requests_total[5m])) by (bot_id, direction, status)",
                    "seriesNameFormat": "bot {{bot_id}} {{direction}} {{status}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-12": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CRM Latency p95, s"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(air_tguserbot_crm_request_duration_seconds_bucket[5m])) by (le, bot_id, direction))",
                    "seriesNameFormat": "bot {{bot_id}} {{direction}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-13": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "TgUserBot Send"
