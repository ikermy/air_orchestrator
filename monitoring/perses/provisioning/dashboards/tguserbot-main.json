                  "spec": {
                    "query": "sum(rate(air_tguserbot_tguserbot_send_total[5m])) by (bot_id, status)",
                    "seriesNameFormat": "bot {{bot_id}} {{status}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-14": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Reconnects"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
