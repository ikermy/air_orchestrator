              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_call_lifecycle_total[5m])) by (bot_id, direction, action, status)",
                    "seriesNameFormat": "bot {{bot_id}} {{direction}} {{action}} {{status}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-19": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "WebSocket Events"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_websocket_events_total[5m])) by (route, status)",
                    "seriesNameFormat": "{{route}} {{status}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": ""
