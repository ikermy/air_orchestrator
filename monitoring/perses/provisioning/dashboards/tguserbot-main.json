            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_reconnects_total[5m])) by (bot_id, result)",
                    "seriesNameFormat": "bot {{bot_id}} {{result}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-15": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Decrypt Errors"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(air_tguserbot_decrypt_errors_total[5m])) by (bot_id, category)",
                    "seriesNameFormat": "bot {{bot_id}} {{category}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-16": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active Dialogs"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(air_tguserbot_active_dialogs) by (bot_id)",
                    "seriesNameFormat": "bot {{bot_id}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-17": {
