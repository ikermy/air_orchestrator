{
  "kind": "Dashboard",
  "metadata": {
    "name": "airorc-main",
    "project": "air"
  },
  "spec": {
    "display": {
      "name": "AiR ORCHESTRATOR"
    },
    "duration": "1h",
    "refreshInterval": "15s",
    "panels": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP RPS"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(airorc_http_requests_total[1m]))",
                    "seriesNameFormat": "RPS"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP Latency p95, s"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(airorc_http_request_duration_seconds_bucket[5m])) by (le))",
                    "seriesNameFormat": "p95"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active WebSocket Sessions"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "airorc_ws_active_sessions",
                    "seriesNameFormat": "WS Sessions"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active AI Test Sessions"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "airorc_api_active_test_sessions",
                    "seriesNameFormat": "Test Sessions"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP Requests by Route"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(airorc_http_requests_total[1m])) by (method, path)",
                    "seriesNameFormat": "{{method}} {{path}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP Error Rate (4xx+5xx)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(airorc_http_requests_total{status_code=~\"[45]..\"}[1m])) by (path, status_code)",
                    "seriesNameFormat": "{{status_code}} {{path}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Auth Attempts"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(airorc_auth_attempts_total[1m])) by (result)",
                    "seriesNameFormat": "{{result}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "DB Query Duration p95, s"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate(airorc_db_query_duration_seconds_bucket[5m])) by (le, operation))",
                    "seriesNameFormat": "{{operation}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": ""
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/panel-1"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/panel-2"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/panel-3"
              }
            },
            {
              "x": 18,
              "y": 0,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/panel-4"
              }
            },
            {
              "x": 0,
              "y": 4,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/panel-5"
              }
            },
            {
              "x": 0,
              "y": 12,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/panel-6"
              }
            },
            {
              "x": 12,
              "y": 12,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/panel-7"
              }
            },
            {
              "x": 0,
              "y": 20,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/panel-8"
              }
            }
          ]
        }
      }
    ]
  }
}
